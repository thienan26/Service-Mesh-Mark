      "Bash(curl -s -o /dev/null -w \"gateway: %{http_code}\\\\n\" http://127.0.0.1:18080/products --max-time 3)",
      "Bash(curl -s \"http://127.0.0.1:16686/jaeger/api/services\")",
      "Bash(curl -s \"http://127.0.0.1:20001/kiali/api/namespaces/meshmart/graph?graphType=versionedApp&duration=300s\" -o /tmp/kiali-graph.json -w \"kiali graph http_code: %{http_code}\\\\n\")",
      "Bash(curl -s \"http://127.0.0.1:20001/kiali/api/namespaces/meshmart/graph?duration=600s&graphType=versionedApp\" -w \"\\\\nHTTP_CODE:%{http_code}\\\\n\")",
      "Bash(curl -s \"http://127.0.0.1:20001/api/namespaces/meshmart/graph?duration=600s&graphType=versionedApp\" -w \"\\\\nHTTP_CODE:%{http_code}\\\\n\")",
      "Bash(curl -s \"http://127.0.0.1:20001/kiali/api/graph?namespaces=meshmart&duration=600s&graphType=versionedApp\" -w \"\\\\nHTTP_CODE:%{http_code}\\\\n\" -o /tmp/graph2.json)",
      "Bash(curl -s \"http://127.0.0.1:20001/kiali/api/config\" -w \"\\\\nHTTP_CODE:%{http_code}\\\\n\")",
      "Bash(curl -s \"http://127.0.0.1:20001/api/config\" -w \"\\\\nHTTP_CODE:%{http_code}\\\\n\")",
      "Bash(curl -s \"http://127.0.0.1:20001/kiali/api/namespaces/graph?namespaces=meshmart&duration=120s&graphType=versionedApp\" -o /tmp/graph4.json)"
    ]
  }
}
